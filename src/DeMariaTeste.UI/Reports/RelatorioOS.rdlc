<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <EmbeddedImages>
    <EmbeddedImage Name="logo">
      <MIMEType>image/png</MIMEType>
      <ImageData></ImageData>
    </EmbeddedImage>
  </EmbeddedImages>
  <DataSources>
    <DataSource Name="DummyDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>9d2a4f0e-1b3e-4f3a-8a5d-1d4d9d2a4f0e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="LinhasOS">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText>/* dataset preenchido em runtime via ReportDataSource */</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="OrdemServicoId"><DataField>OrdemServicoId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Cliente"><DataField>Cliente</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Documento"><DataField>Documento</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DataAbertura"><DataField>DataAbertura</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="DataConclusao"><DataField>DataConclusao</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="Status"><DataField>Status</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ValorTotal"><DataField>ValorTotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ValorImposto"><DataField>ValorImposto</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
      <Image Name="imgLogo">
            <Source>Embedded</Source>
            <Value>logo</Value>
            <Sizing>FitProportional</Sizing>
            <Top>0.2in</Top><Left>0.3in</Left><Height>0.7in</Height><Width>0.7in</Width>
          </Image>
      <Textbox Name="txtTitulo">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Relatorio de Ordens de Servico</Value>
                <Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <rd:DefaultName>txtTitulo</rd:DefaultName>
        <Top>0.35in</Top><Left>1.1in</Left><Height>0.4in</Height><Width>9in</Width>
      </Textbox>
      <Tablix Name="tblOS">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>1.4in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>1.2in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="hOS"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>OS</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hAbertura"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Abertura</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hConclusao"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Conclusao</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hStatus"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Status</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hDoc"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Documento</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hImp"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Imposto</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="hTotal"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.22in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="cOS"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OrdemServicoId.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cAbertura"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DataAbertura.Value</Value><Style><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cConclusao"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DataConclusao.Value</Value><Style><Format>dd/MM/yyyy</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cStatus"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Status.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cDoc"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Documento.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cImp"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ValorImposto.Value</Value><Style><Format>N2</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="cTotal"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ValorTotal.Value</Value><Style><Format>N2</Format></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell><CellContents><Textbox Name="gQtde"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Count(Fields!OrdemServicoId.Value)</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gLbl"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>OS p/ cliente</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gv1"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gv2"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value></Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gv3"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Subtotal</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gImpostoCliente"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!ValorImposto.Value)</Value><Style><Format>N2</Format><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                <TablixCell><CellContents><Textbox Name="gTotalCliente"><Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><BackgroundColor>#1EBBF4</BackgroundColor><Color>White</Color><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!ValorTotal.Value)</Value><Style><Format>N2</Format><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers>
          <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
        </TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember>
              <Group Name="grpCliente"><GroupExpressions><GroupExpression>=Fields!Cliente.Value</GroupExpression></GroupExpressions></Group>
              <SortExpressions><SortExpression><Value>=Fields!Cliente.Value</Value></SortExpression></SortExpressions>
              <TablixHeader>
                <Size>1.5in</Size>
                <CellContents>
                  <Textbox Name="grupoCliente">
                    <Style><Border><Style>Dotted</Style><Width>0.5pt</Width></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Cliente.Value</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                  </Textbox>
                </CellContents>
              </TablixHeader>
              <TablixMembers>
                <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
                <TablixMember><Group Name="grpDetalhe" /></TablixMember>
                <TablixMember><KeepWithGroup>Before</KeepWithGroup></TablixMember>
              </TablixMembers>
            </TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>LinhasOS</DataSetName>
        <Top>1.2in</Top><Left>0.3in</Left><Height>1in</Height><Width>10in</Width>
      </Tablix>
      <Textbox Name="txtTotaisGerais">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=
"Total geral: " + Format(Sum(Fields!ValorTotal.Value, "LinhasOS"), "N2") +
" | Imposto total: " + Format(Sum(Fields!ValorImposto.Value, "LinhasOS"), "N2") +
" | OS no periodo: " + CStr(Count(Fields!OrdemServicoId.Value, "LinhasOS"))</Value>
                <Style><FontWeight>Bold</FontWeight></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>2.4in</Top><Left>0.3in</Left><Height>0.4in</Height><Width>10in</Width>
      </Textbox>
        </ReportItems>
        <Height>3in</Height>
      </Body>
      <Width>10.4in</Width>
      <Page>
        <PageHeight>8.5in</PageHeight>
        <PageWidth>11in</PageWidth>
        <LeftMargin>0.3in</LeftMargin>
        <RightMargin>0.3in</RightMargin>
        <TopMargin>0.3in</TopMargin>
        <BottomMargin>0.3in</BottomMargin>
        <ColumnSpacing>0.13in</ColumnSpacing>
      </Page>
    </ReportSection>
  </ReportSections>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
</Report>
